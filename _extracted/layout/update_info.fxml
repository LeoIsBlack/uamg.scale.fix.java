<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- UpdateInfoModel задаёт корню высоту 341 и сам меняет иконку, тексты и кнопки. -->
<VBox alignment="TOP_CENTER" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="341.0" prefWidth="726.0" spacing="8.0" styleClass="mainWindow, dialogSurface, dialogUpdate" stylesheets="@../styles/common.css, @../styles/update_info.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.umag.scale.ui.UpdateInfoModel">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <ImageView fx:id="iconImg" fitHeight="56.0" fitWidth="56.0" preserveRatio="true">
         <image>
            <Image url="@../image/update_icon.png" />
         </image>
      </ImageView>
      <Text fx:id="titleText" styleClass="dialogTitle" text="Появилась новая версия " textAlignment="CENTER" wrappingWidth="660.0" />
      <Text fx:id="newVersionText" styleClass="sectionTitle" text="Что нового в версии 4.0.1:" />
      <HBox spacing="16.0" VBox.vgrow="ALWAYS">
         <children>
            <TextFlow fx:id="addedTextFlow" prefWidth="329.0" styleClass="updateNotes" HBox.hgrow="ALWAYS" />
            <TextFlow fx:id="fixedTextFlow" prefWidth="329.0" styleClass="updateNotes" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <JFXButton fx:id="secondary" maxWidth="Infinity" prefHeight="48.0" styleClass="secondary" text="ЗАКРЫТЬ" HBox.hgrow="ALWAYS" />
            <JFXButton fx:id="primary" maxWidth="Infinity" prefHeight="48.0" styleClass="primary" text="ОБНОВИТЬ" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
