<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane fx:id="mainContainer" maxHeight="-Infinity" maxWidth="-Infinity"
            styleClass="border" stylesheets="@../styles/stop_screen.css" xmlns="http://javafx.com/javafx/8.0.111"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <VBox maxWidth="100">
            <Text fx:id="title" strokeType="OUTSIDE" strokeWidth="0.0"
                  text="ПРОВЕРКА ПРАВИЛЬНОСТИ УСТАНОВЛЕННОГО ВРЕМЕНИ КАССЫ">
                <VBox.margin>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                </VBox.margin>
                <font>
                    <Font size="17.0"/>
                </font>
            </Text>
            <Text strokeType="OUTSIDE" strokeWidth="0.0"
                  text="В СВЯЗИ С ОТСУТСТВИЕМ ПОДКЛЮЧЕНИЯ К ИНТЕРНЕТУ &#13;НЕ УДАЛОСЬ СВЕРИТЬ ВРЕМЯ. &#13;ВРЕМЯ КАССЫ БУДЕТ ОТОБРАЖАТЬСЯ НА ЧЕКАХ И ДРУГИХ ОПЕРАЦИЯХ.&#13;ЕСЛИ ВРЕМЯ НЕВЕРНОЕ, СИНХРОНИЗАЦИЯ С СЕРВЕРОМ НЕ БУДЕТ РАБОТАТЬ.">
                <VBox.margin>
                    <Insets left="10.0" right="10.0" top="10.0"/>
                </VBox.margin>
                <font>
                    <Font size="17.0"/>
                </font>
            </Text>
            <Text strokeType="OUTSIDE" strokeWidth="0.0"
                  text="ДЛЯ ПРОВЕРКИ ВЫБЕРИТЕ ПРАВИЛЬНОЕ ТЕКУЩЕЕ ВРЕМЯ.">
                <VBox.margin>
                    <Insets left="10.0" right="10.0" top="10.0"/>
                </VBox.margin>
                <font>
                    <Font size="17.0"/>
                </font>
            </Text>
        </VBox>
    </top>
    <center>
        <GridPane fx:id="grid" alignment="CENTER">
            <Button fx:id="first" mnemonicParsing="false" GridPane.columnIndex="1"
                    GridPane.rowIndex="1">
                <GridPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </GridPane.margin>
            </Button>
            <Button fx:id="second" mnemonicParsing="false" GridPane.columnIndex="1"
                    GridPane.rowIndex="2">
                <GridPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </GridPane.margin>
            </Button>

            <Button fx:id="third" mnemonicParsing="false" GridPane.columnIndex="2"
                    GridPane.rowIndex="1">
                <GridPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </GridPane.margin>
            </Button>

            <Button fx:id="fourth" mnemonicParsing="false" GridPane.columnIndex="2"
                    GridPane.rowIndex="2">
                <GridPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </GridPane.margin>
            </Button>

        </GridPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" styleClass="border" BorderPane.alignment="CENTER">
            <Button fx:id="allWrong" mnemonicParsing="false" prefHeight="80.0" text="НИЧТО ИЗ ВЫШЕПЕРЕЧИСЛЕННОГО"/>
        </HBox>
    </bottom>
</BorderPane>
