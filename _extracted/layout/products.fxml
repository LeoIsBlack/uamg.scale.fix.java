<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<!-- Корень — AnchorPane: ProductsControl добавляет в него экранную клавиатуру. -->
<AnchorPane fx:id="root" prefHeight="734.0" prefWidth="1024.0" styleClass="productsRoot" stylesheets="@../styles/common.css, @../styles/products.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.umag.scale.ui.ProductsControl">
   <children>
      <BorderPane AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
         <top>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <JFXButton fx:id="backToSyncButton" minWidth="-Infinity" onAction="#backToSync" prefHeight="44.0" styleClass="secondary" text="К СИНХРОНИЗАЦИИ" />
                  <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                     <children>
                        <TextField fx:id="searchTextField" prefHeight="44.0" promptText="Поиск по названию или штрихкоду" styleClass="searchField" />
                        <Region mouseTransparent="true" styleClass="icon, searchIcon">
                           <StackPane.margin>
                              <Insets left="14.0" />
                           </StackPane.margin>
                        </Region>
                     </children>
                  </StackPane>
               </children>
            </HBox>
         </top>
         <center>
            <TableView fx:id="productsTableView">
               <BorderPane.margin>
                  <Insets top="12.0" />
               </BorderPane.margin>
               <placeholder>
                  <Label styleClass="placeholderText" text="Товары не найдены" />
               </placeholder>
               <columns>
                  <TableColumn fx:id="indexTableColumn" maxWidth="70.0" minWidth="40.0" prefWidth="48.0" sortable="false" text="#" />
                  <TableColumn fx:id="nameTableColumn" minWidth="140.0" prefWidth="280.0" text="Наименование" />
                  <TableColumn fx:id="barcodeTableColumn" minWidth="90.0" prefWidth="130.0" text="Штрихкод" />
                  <TableColumn fx:id="priceTableColumn" minWidth="70.0" prefWidth="110.0" text="Цена" />
                  <TableColumn fx:id="additionalCodeTableColumn" minWidth="70.0" prefWidth="100.0" text="Доп. код" />
                  <TableColumn fx:id="numberOnScaleTableColumn" minWidth="80.0" prefWidth="110.0" text="№ на весах" />
                  <TableColumn fx:id="editTimeTableColumn" minWidth="120.0" prefWidth="170.0" text="Дата изменения" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
