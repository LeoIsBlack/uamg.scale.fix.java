<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="728" prefWidth="1024" styleClass="loadRoot" stylesheets="@../styles/common.css, @../styles/load_screen.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.umag.scale.ui.LoadScreenNew">
   <children>
      <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <ImageView fitHeight="54.0" fitWidth="262.0" preserveRatio="true" styleClass="appLogo">
               <image>
                  <Image url="@../image/umag_scale_logo.png" />
               </image>
            </ImageView>
            <Text fx:id="versionTextInfo" styleClass="mutedText" text="Версия 4.0.0" textAlignment="CENTER" />
            <ImageView fitHeight="110.0" fitWidth="200.0" preserveRatio="true">
               <image>
                  <Image url="@../image/loading.gif" />
               </image>
            </ImageView>
            <ImageView fitHeight="149.0" fitWidth="200.0" preserveRatio="true">
               <image>
                  <Image url="@../image/robot.png" />
               </image>
            </ImageView>
            <Label fx:id="progressText" alignment="CENTER" prefWidth="572.0" styleClass="loadProgress" text="Инициализируем . . .  базу данных. " textAlignment="CENTER" />
            <Text styleClass="bodyText" text="Пожалуйста, подождите. Это может занять несколько минут." textAlignment="CENTER" />
         </children>
      </VBox>
      <VBox alignment="CENTER" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
         <children>
            <Text styleClass="poweredBy" text="POWERED BY UMAG.KZ™" />
         </children>
      </VBox>
   </children>
</AnchorPane>
