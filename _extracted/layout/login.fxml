<HBox alignment="CENTER" prefHeight="768" prefWidth="1024" stylesheets="@../styles/login.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.umag.scale.ui.LoginControl">
   <children>
      <VBox prefHeight="768.0" prefWidth="1096.0">
         <children>
            <AnchorPane onMouseClicked="#onHeaderClicked" onMouseDragged="#onHeaderDragged" onMousePressed="#onHeaderPressed" prefHeight="844.0" prefWidth="1024.0">
               <children>
                  <HBox alignment="CENTER_RIGHT" layoutX="840.0" layoutY="12.0" spacing="5.0">
                     <children>
                        <Button fx:id="themeToggleBtn" mnemonicParsing="false" onAction="#toggleTheme" text="🌙" styleClass="winBtn, winBtnTheme" />
                        <Button fx:id="minimizeBtn" mnemonicParsing="false" onAction="#minimizeWindow" text="🗕" styleClass="winBtn, winBtnMinimize" />
                        <Button fx:id="maximizeBtn" mnemonicParsing="false" onAction="#maximizeWindow" text="🗖" styleClass="winBtn, winBtnMaximize" />
                        <Button fx:id="closeBtn" mnemonicParsing="false" onAction="#closeWindow" text="✕" styleClass="winBtn, winBtnClose" />
                     </children>
                  </HBox>
                  <TextField fx:id="otpTextField" layoutX="389.0" layoutY="334.0" prefHeight="34.0" prefWidth="252.0" promptText="Единоразовый ключ доступа" />
