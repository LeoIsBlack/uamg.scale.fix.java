                  <Text layoutX="392.0" layoutY="740.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="textUmag" text="POWERED BY UMAG.KZ™" />
                  <ImageView fitHeight="37.0" fitWidth="200.0" layoutX="403.0" layoutY="145.0">
                     <image>
                        <Image url="@../image/umag_scale_logo.png" />
                     </image>
                  </ImageView>
                  <Text layoutX="398.0" layoutY="201.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Версия 4.0.0-разработка" textAlignment="CENTER" wrappingWidth="209.13671875">
                     <font>
                        <Font name="Roboto" size="13.0" />
                     </font>
                  </Text>
                  <Label fx:id="errorMessage" alignment="TOP_CENTER" layoutX="263.0" layoutY="368.0" prefHeight="17.0" prefWidth="504.0" text="Неверный пароль, попробуйте снова" textAlignment="CENTER" textFill="#ff3826" visible="false" />
