<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- Окно использует стандартную рамку Windows (свернуть / развернуть / закрыть),
     поэтому своих кнопок управления окном в шапке нет. -->
<BorderPane prefHeight="768" prefWidth="1024" styleClass="appRoot" stylesheets="@../styles/common.css, @../styles/main.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.umag.scale.ui.TabControl">
    <fx:define>
        <ToggleGroup fx:id="toggleGroup" />
    </fx:define>
    <top>
        <BorderPane styleClass="headerBar">
            <left>
                <HBox alignment="CENTER_LEFT" fillHeight="false" spacing="10.0">
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                    <Button fx:id="menuButton" mnemonicParsing="false" styleClass="iconButton">
                        <graphic>
                            <Region styleClass="icon, menuIcon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Меню" />
                        </tooltip>
                    </Button>
                    <TextFlow>
                        <Text styleClass="headerMuted" text="Магазин: " />
                        <Text fx:id="companyNameText" styleClass="headerStrong" text=" Демо" />
                    </TextFlow>
                </HBox>
            </left>
            <right>
                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                    <Text fx:id="lastSyncDateText" styleClass="headerMuted" text="Дата последней синхронизации: 12.01.2020" />
                    <Text fx:id="time" styleClass="headerStrong" text="00:00" />
                    <Circle fx:id="conStatus" fill="#2dbe60" radius="6.0" />
                    <Button fx:id="themeToggleBtn" mnemonicParsing="false" onAction="#toggleTheme" styleClass="iconButton, themeToggle">
                        <graphic>
                            <Region styleClass="icon, themeIcon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Светлая / тёмная тема" />
                        </tooltip>
                    </Button>
                </HBox>
            </right>
        </BorderPane>
    </top>
    <center>
        <StackPane fx:id="container" styleClass="appContainer" />
    </center>
    <left>
        <BorderPane fx:id="sideMenu" prefWidth="260.0">
            <top>
                <VBox spacing="4.0">
                    <padding>
                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                    </padding>
                    <ToggleButton fx:id="syncTB" maxWidth="Infinity" mnemonicParsing="false" prefHeight="48.0" text="Синхронизация" toggleGroup="$toggleGroup" userData="SYNC" styleClass="tabButton, tabButtonSync">
                        <graphic>
                            <StackPane prefWidth="24.0">
                                <ImageView>
                                    <Image url="@../image/sync_logo.png" />
                                </ImageView>
                            </StackPane>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="productTB" maxWidth="Infinity" mnemonicParsing="false" prefHeight="48.0" text="Товары" toggleGroup="$toggleGroup" userData="PRODUCTS" styleClass="tabButton, tabButtonProducts">
                        <graphic>
                            <StackPane prefWidth="24.0">
                                <ImageView>
                                    <Image url="@../image/products_logo.png" />
                                </ImageView>
                            </StackPane>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="updateTB" maxWidth="Infinity" mnemonicParsing="false" prefHeight="48.0" text="Проверить обновление" toggleGroup="$toggleGroup" userData="UPDATE" styleClass="tabButton, tabButtonUpdate">
                        <graphic>
                            <StackPane prefWidth="24.0">
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <Image url="@../image/update_logo.png" />
                                </ImageView>
                            </StackPane>
                        </graphic>
                    </ToggleButton>
                    <ToggleButton fx:id="exitTB" maxWidth="Infinity" mnemonicParsing="false" prefHeight="48.0" text="Выход" toggleGroup="$toggleGroup" userData="EXIT" styleClass="tabButton, tabButtonExit">
                        <graphic>
                            <StackPane prefWidth="24.0">
                                <ImageView>
                                    <Image url="@../image/exit_logo.png" />
                                </ImageView>
                            </StackPane>
                        </graphic>
                    </ToggleButton>
                </VBox>
            </top>
            <bottom>
                <Label fx:id="versionText" styleClass="versionText" text="Версия 4.0.0" />
            </bottom>
        </BorderPane>
    </left>
</BorderPane>
